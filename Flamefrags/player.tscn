[sub_resource type="GDScript" id="GDScript_tgymd"]
script/source = "extends Node2D

func _physics_process(delta):
	if has_node(\"killzone\") and has_node(\"player\"):
		$killzone.position.y = $player.position.y
		$killzone.position.x += $player.SPEED * delta

func _on_kill_zone_body_entered(body):
	if has_node(\"killzone\"):
		var things = $killzone.get_overlapping_bodies()
		for t in things:
			if t.has_method(\"Explode\"):
				t.Explode()
		body.queue_free()
		


func _on_audio_stream_player_2d_finished() -> void:
	pass # Replace with function body.
"

